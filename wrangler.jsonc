{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "promptandco",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "RATE_LIMIT_DB",
      "database_name": "promptco-rate-limit",
      "database_id": "bda35c17-cbea-43d4-abb3-27848b29104f"
    }
  ]
}
